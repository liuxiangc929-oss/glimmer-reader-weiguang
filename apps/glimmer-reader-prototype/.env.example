# AI mode:
# - mock: stable portfolio demo, no real API call.
# - live: call the local server-side AI gateway.
AI_MODE="mock"
AI_SUMMARY_MODE="mock"
AI_ASSIST_MODE="mock"

# DeepSeek provider settings. Put the real key only in .env.local.
# Never put real keys in src/, README, Git commits, or Codex messages.
AI_PROVIDER="deepseek"
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_SMALL_MODEL="deepseek-v4-flash"
DEEPSEEK_PRO_MODEL="deepseek-v4-pro"

# The gateway falls back to mock content if live requests are too slow.
AI_TIMEOUT_MS="12000"
AI_PRO_TIMEOUT_MS="30000"
